      "fallbackToCacheTimeout": 0
    },
    "android": {
      "package": "uz.tartib.app",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a2016"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "uz.tartib.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Namoz vaqtlari va Qibla yo'nalishini aniqlash uchun joylashuvingiz kerak."
      }
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Namoz vaqtlari va Qibla yo'nalishini aniqlash uchun joylashuvingiz ishlatiladi."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#EEC271"
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-camera",
        {
          "cameraPermission": "QR taklif kodini skanerlab jamoaga qo'shilish uchun kamera ishlatiladi."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Ilovani ochish uchun Face ID ishlatiladi."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0a1f18"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c6f427a8-d221-41a7-b5eb-8739651c5abc"
      }
    }
